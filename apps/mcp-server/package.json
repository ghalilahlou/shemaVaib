{
  "name": "@schemavibe/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "schemavibe-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch",
    "start": "node dist/index.js",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "verifier-connexion": "node dist/verifier-connexion.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@schemavibe/shared-types": "workspace:*",
    "@supabase/supabase-js": "2.117.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
