# Valeurs par défaut d'une instance Supabase locale démarrée avec `pnpm db:start`.
# Copier ce fichier en `.env.local` et remplacer par les valeurs affichées par
# `pnpm db:status` (les clés sont régénérées à chaque environnement).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Adresse publique du site, base des liens envoyés par e-mail. Facultative en
# développement ; obligatoire en production, où le serveur refuse de servir
# sans elle (voir README, Déploiement).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
