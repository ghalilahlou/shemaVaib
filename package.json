{
  "name": "schemavibe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:deps": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm run build:deps && pnpm -r run typecheck",
    "test": "pnpm run build:deps && pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "pnpm --filter @schemavibe/web exec supabase"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
